<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon />
    <Win32Resource />
    <!-- Strong-naming is set repo-wide in ../../Directory.Build.props. Signed because
         NumSharp.Core grants it InternalsVisibleTo, which now names a PublicKey. -->
    <Configurations>Debug;Release;Publish</Configurations>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.11" />
    <!-- System.Memory, System.Runtime.CompilerServices.Unsafe and Microsoft.CSharp are built into
         net8.0+ (a PackageReference to any of them draws the .NET 10 SDK's NU1510 pruning warning). -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NumSharp.Core\NumSharp.Core.csproj" />
  </ItemGroup>

  <Target Name="LogDebugInfo">
    <Message Text="Building for $(TargetFramework) on $(OS)" Importance="High" />
  </Target>

</Project>
