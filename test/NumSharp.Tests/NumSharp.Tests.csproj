<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <!-- Strong-naming is set repo-wide in ../../Directory.Build.props. Signed because
         NumSharp.Core grants it InternalsVisibleTo, which now names a PublicKey. -->
    <Configurations>Debug;Release;Publish</Configurations>
    <RootNamespace>NumSharp.Tests</RootNamespace>
    <!-- JIT posture for this TEST HOST: tiered compilation stays ON, TieredPGO is switched OFF — a per-project
         override of the repo-wide default in ../../Directory.Build.props, which names exactly this kind of
         override. A test host is short-lived and JIT-bound (it runs tens of thousands of distinct methods a
         handful of times each), so PGO's instrumented tier — one more JIT of every hot method, plus the probe
         overhead while it runs — never pays back before the process exits. Measured 2026-09-24, net10.0, CI
         filter, best of 2 alternating runs, summed test durations with identical pass/skip counts:
         NumSharp.Tests 65.8 s -> 61.4 s, NumSharp.Tests.Oracle 16.6 s -> 14.2 s,
         NumSharp.Tests.Build.Analyzer 23.9 s -> 20.7 s. Tier-1 code only loses PGO-guided layout and guarded
         devirtualization; no test asserts steady-state speed tightly enough to notice. -->
    <TieredPGO>false</TieredPGO>
    <!-- GC posture for this TEST HOST: the server GC with EIGHT heaps (testhost reads this project's
         runtimeconfig.json; the product and its consumers are untouched). The tests run in parallel
         (Utilities/TestParallelization.cs), and with the workstation GC every allocating thread contends for the
         one heap's allocation and finalization locks. Measured 2026-10-16 on an i9-13900K (32 logical CPUs), a
         24-thread np.zeros/Dispose + small-op churn followed by 400 forced young collections (the GcQuiescence
         pattern of the [DoNotParallelize] tests, which run alone afterwards):
           workstation          churn 3,837 ms   young GC 0.13 ms
           server, default      churn   937 ms   young GC 4.95 ms  (DATAS; every collection wakes ~32 GC threads)
           server, 8 heaps      churn   523 ms   young GC 0.40 ms
           server, 4 heaps      churn   666 ms   young GC 0.24 ms
           server, 16 heaps     churn   672 ms   young GC 0.97 ms
         Eight heaps is fastest for the parallel phase and keeps the serial phase's 800+ forced collections
         cheap; the runtime clamps the count to the processors the host has, so a 4-CPU CI runner gets 4. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- The run settings `dotnet test`, Visual Studio and Rider apply to this project: VSTest's result batching,
         without which the parallel run (Utilities/TestParallelization.cs) waits on the host's reporting lock. The
         file explains the setting and its measurement. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)NumSharp.Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- See the GC posture note above: the server GC's heap count, fixed (a fixed count also turns DATAS off). -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="8" />
  </ItemGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Publish|AnyCPU'">
    <DocumentationFile />
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="data\**" />
    <EmbeddedResource Remove="data\**" />
    <None Remove="data\**" />
    <None Remove="NumSharp.Bitmap\resources\odd-width.png" />
    <EmbeddedResource Include="NumSharp.Bitmap\resources\odd-width.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\examples\gist\NumSharp.GistExamples.csproj" />
    <ProjectReference Include="..\..\src\NumSharp.Bitmap\NumSharp.Bitmap.csproj" />
    <ProjectReference Include="..\..\src\NumSharp.Core\NumSharp.Core.csproj" />
    <!-- The optional external-CBLAS/LAPACK engine. The differential-fuzz oracle (incl. the
         host-pinned matmul_parity tier) moved to NumSharp.Tests.Oracle; this project keeps the
         reference for its remaining ENGINE tests — the LAPACK factorisation gates in Backends/,
         LinAlgEngineSeamTests (which asserts the NO-backend contract), and the Level-3 BLAS binding
         tests. Its module initializer would install the engine for the whole test run, which must
         NOT happen (every other tier asserts NumSharp's own kernels, and the seam test asserts the
         backend is ABSENT), so this assembly opts out via NUMSHARP_OPENBLAS_BUNDLE_AUTOINSTALL=0 in
         its own BlasEngineAutoInstallGuard and the engine tests enable it per-test instead. -->
    <ProjectReference Include="..\..\src\NumSharp.Interop.OpenBLAS\NumSharp.Interop.OpenBLAS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../examples/gist/demo-output.txt" Link="GistDemoOutput.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/gist/karpathy/demo-output.txt" Link="KarpathyDemoOutput.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="data\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The differential-fuzzer oracle corpus (Fuzz/corpus/**) moved to NumSharp.Tests.Oracle. -->

  <!-- .npy/.npz format oracle: real NumPy 2.4.2 output, replayed by NpyOracleTests (no Python in CI). -->
  <ItemGroup>
    <None Update="IO\corpus\npy_oracle.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- numpy.dtype / DType-class oracle: real NumPy 2.4.2 member names, descriptor attributes, errors, comparisons,
       promotions, class attributes and casting resolutions, one file per C long model (llp64 = Windows NumPy,
       lp64 = Linux NumPy), replayed by DTypeOracleTests (no Python in CI). Regenerate:
       python test/oracle/gen_dtype_oracle.py, and the same under WSL's Linux NumPy for lp64. -->
  <ItemGroup>
    <None Update="DTypes\corpus\dtype_oracle.*.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- np.find_common_type oracle: NumPy 1.26.4, the last NumPy with the function (2.0 removed it), replayed by
       np_find_common_type_numpy1264_tests. Regenerate from a numpy==1.26.4 environment:
       python test/oracle/gen_find_common_type_oracle.py -->
  <ItemGroup>
    <None Update="Logic\corpus\find_common_type.numpy1264.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- np.asanyarray(object[]) oracle: the dtype NumPy 2.4.2's array coercion gives mixed scalars, in every order,
       replayed by np_asanyarray_mixed_scalars_tests. Regenerate: python test/oracle/gen_asanyarray_mixed_oracle.py -->
  <ItemGroup>
    <None Update="Creation\corpus\asanyarray_mixed.numpy242.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ndarray.flags / ndarray.setflags oracle: real NumPy 2.4.2 flag records + verbatim errors,
       replayed by FlagsOracleTests (no Python in CI). Regenerate: python test/oracle/gen_flags_oracle.py -->
  <ItemGroup>
    <None Update="Backends\corpus\flags_oracle.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Layout-parity oracle: real NumPy 2.4.2 layout/strides/flags/shares/VALUES records for the
       modelled numpy-internal representations (reshape nocopy-views, KEEPORDER sorts/copies, the
       concat/stack stride vote, nonzero shared-buffer views, linspace owndata, read-only reduction
       scalars, broadcast writeable inherit), replayed bit-exact by LayoutParityOracleTests
       (no Python in CI). Regenerate: python test/oracle/gen_layout_parity_oracle.py -->
  <ItemGroup>
    <None Update="Backends\corpus\layout_parity_oracle.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Hand-made NumPy fixtures for NumpyCompatibilityTests / NpyFormatVersionTests. Those tests
       resolve "test_compat" relative to the working directory and SKIP (silently passing) when it is
       absent, so without this rule they assert nothing on a clean checkout. -->
  <ItemGroup>
    <None Update="test_compat\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <ItemGroup>
    <None Remove="NumSharp.Bitmap\resources\captcha-a.png" />
    <None Remove="NumSharp.Bitmap\resources\captcha-b.png" />
    <None Remove="NumSharp.Bitmap\resources\captcha-c.png" />
    <None Remove="NumSharp.Bitmap\resources\captcha-d.png" />
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Include="NumSharp.Bitmap\resources\captcha-a.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="NumSharp.Bitmap\resources\captcha-b.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="NumSharp.Bitmap\resources\captcha-c.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="NumSharp.Bitmap\resources\captcha-d.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
</Project>
