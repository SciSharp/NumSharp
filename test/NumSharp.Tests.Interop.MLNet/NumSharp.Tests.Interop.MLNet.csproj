<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <!-- Strong-naming is set repo-wide in ../../Directory.Build.props. Signed because
         NumSharp.Interop.MLNet grants it InternalsVisibleTo, which names a PublicKey. -->
    <Configurations>Debug;Release;Publish</Configurations>

    <!-- Which ML.NET the suite runs against. The DEFAULT is the package's FLOOR (Microsoft.ML 2.0.1, which
         carries Microsoft.ML.DataView 2.0.0 — the version the package is compiled against and the version
         NuGet resolves for a consumer who adds nothing newer), so CI exercises exactly the out-of-box
         combination; the release pipeline runs the suite a second time with `-p:MLNetVersion=<current>` so
         the current ML.NET is covered too. Override locally the same way: dotnet test -p:MLNetVersion=4.0.2. -->
    <MLNetVersion Condition="'$(MLNetVersion)' == ''">2.0.1</MLNetVersion>

    <!-- JIT posture for this TEST HOST: tiered compilation OFF, so every method is compiled fully optimized on its
         first call. The lifetime suite (LifetimeGcTests) probes windows in which an object is already unreachable
         while code still reads memory it owns — a getter's cursor during the row copy. Those windows exist only in
         OPTIMIZED code: tier-0 code reports every local as live for the whole method. With tiering on, a method reaches
         tier 1 only after 30 calls, a quiet period and a background compile. In a whole-suite run (other tests'
         compile backlog, their jitting resetting the call-counting delay), the probe's warm-up never got there: its
         no-KeepAlive control was caught in 0 of 12 rounds, against 12 of 12 when run alone or with tiering off. This
         posture also runs EVERY other test of the bridge against optimized code, where a missing KeepAlive is a live
         bug rather than a latent one. Cost, measured 2026-10-03 (net10.0, Release, whole suite): 36.3 s -> 38.9 s.
         Overrides the repo-wide default in ../../Directory.Build.props; TieredPGO needs tiering, so it is off with it. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Publish|AnyCPU'">
    <DocumentationFile />
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
    <!-- The FULL ML.NET — MLContext, the transforms and trainers, the pipeline API. The interop package itself
         depends only on the standalone Microsoft.ML.DataView (see its csproj: the runtime lives in Microsoft.ML,
         which the consumer brings); this suite is a consumer, so it brings it. NuGet unifies the .DataView
         dependency to the version this Microsoft.ML carries. -->
    <PackageReference Include="Microsoft.ML" Version="$(MLNetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NumSharp.Core\NumSharp.Core.csproj" />
    <ProjectReference Include="..\..\src\NumSharp.Interop.MLNet\NumSharp.Interop.MLNet.csproj" />
  </ItemGroup>

  <!-- The GC window protocol the pool-balance checks (ArcAccountingTests) measure in: buffers taken minus returned
       is only meaningful while no collection runs finalizers that return unrelated buffers. Linked, not copied, so
       every suite that reads the process-global pool counters shares ONE implementation of the protocol. -->
  <ItemGroup>
    <Compile Include="..\NumSharp.Tests\Utilities\GcQuiescence.cs" Link="Support\GcQuiescence.cs" />
  </ItemGroup>

  <!-- The public-surface formatter the API-approval test (ApiSurfaceTests) compares against its approved list. Linked
       from the ONNX Runtime suite so both packages' approvals render a surface the same way (defaults, `this`, `params`
       and by-reference modifiers included). -->
  <ItemGroup>
    <Compile Include="..\NumSharp.Tests.Interop.OnnxRuntime\ApiSurface.cs" Link="Support\ApiSurface.cs" />
  </ItemGroup>

  <!-- The lifetime / GC proof tools (finalizers run by hand in every order, a buffer's reference count, pool poisoning)
       the finalization-order tests (LifetimeGcTests) share with the ONNX Runtime suite. -->
  <ItemGroup>
    <Compile Include="..\NumSharp.Tests.Interop.OnnxRuntime\LifetimeHarness.cs" Link="Support\LifetimeHarness.cs" />
  </ItemGroup>

</Project>
