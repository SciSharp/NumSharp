<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone, Unity-independent harness that compiles the EXACT simulation source Unity runs
       (Assets/Scripts/Simulation/*.cs) against NumSharp.Core and asserts the cellular-automaton
       invariants — above all mass conservation, the property a naive vectorized sand update silently
       breaks. A green run here is evidence the physics the Unity game plays is correct. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- NumSharp.Core is strong-named; a non-signed console harness may reference it. -->
    <SignAssembly>false</SignAssembly>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\UnityProject\Assets\Scripts\Simulation\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\NumSharp.Core\NumSharp.Core.csproj" />
  </ItemGroup>

</Project>
