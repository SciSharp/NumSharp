<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==================================================================================
       NDScoping — a runnable tour of every level and layer of NDScope memory reclamation.
       See DESIGN.md for the spec and README.md for the guided tour.

       This project consumes the weaver + analyzer in SOURCE MODE (ProjectReference +
       an explicit <Import> of the packaged .targets), which is itself instructive: it
       shows the exact machinery a real project gets for free from the NumSharp.Build
       NuGet package. README.md puts the one-line package-mode form beside it.
       ================================================================================== -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <!-- Strong-naming is set repo-wide in ../../Directory.Build.props; the weaver re-signs
         the woven assembly with that same key (StrongNameTests gates the identity). -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NDScoping</RootNamespace>

    <!-- Source-mode weaver: point the imported NDScopeWeave target at the freshly built tool
         (the package would place it under tools/net8.0/any/ and this property would be unset). The
         weaver project is net8.0, so this path is stable across the consumer's own TargetFrameworks. -->
    <NumSharpBuildToolDll>$(MSBuildThisFileDirectory)..\..\tools\NumSharp.Build\bin\$(Configuration)\net8.0\NumSharp.Build.dll</NumSharpBuildToolDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- CounterExamples/ is a SEPARATE project that must NOT compile (Level D — the analyzer demo).
         Keep its sources out of this executable; the SDK would otherwise glob them in. -->
    <Compile Remove="CounterExamples\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NumSharp.Core\NumSharp.Core.csproj" />

    <!-- Build the weaver TOOL (do not link it) so $(NumSharpBuildToolDll) exists at weave time.
         SetTargetFramework pins its single net8.0 output regardless of which of THIS project's
         TargetFrameworks is currently building. -->
    <ProjectReference Include="..\..\tools\NumSharp.Build\NumSharp.Build.csproj" ReferenceOutputAssembly="false" Private="false" SetTargetFramework="TargetFramework=net8.0" />

    <!-- Apply the compile-time ANALYZER (the standard source-mode analyzer reference). It reports
         a wrong / unsupported [NDScoped] target as a build error BEFORE the weave — the same NDW
         codes the CounterExamples project deliberately trips. -->
    <ProjectReference Include="..\..\tools\NumSharp.Build.Analyzer\NumSharp.Build.Analyzer.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- The packaged weave target, imported directly (the source-mode recipe). In package mode this
       import — and the analyzer — arrive automatically from the NumSharp.Build NuGet. -->
  <Import Project="..\..\tools\NumSharp.Build\build\NumSharp.Build.targets" />

</Project>
