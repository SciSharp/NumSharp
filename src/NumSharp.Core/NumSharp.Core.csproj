<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Authors>Eli Belash, Haiping Chen, Meinrad Recheis</Authors>
    <PackageOutputPath>../../packages</PackageOutputPath>
    <Description>NumSharp is the fundamental library for scientific computing with .NET providing a similar API to python's numpy scientific library. NumSharp has full N-D, broadcasting and axis support.  If you want to use .NET to get started with machine learning, NumSharp will be your best tool.</Description>
    <PackageProjectUrl>https://scisharp.github.io/NumSharp/</PackageProjectUrl>
    <Copyright>2021 © SciSharp STACK Team</Copyright>
    <RepositoryUrl>https://github.com/SciSharp/NumSharp</RepositoryUrl>
    <PackageReleaseNotes></PackageReleaseNotes>
    <AssemblyVersion>0.60.0</AssemblyVersion>
    <FileVersion>0.60.0</FileVersion>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Numpy, NumSharp, MachineLearning, Math, Scientific, Numeric, Mathlab, SciSharp</PackageTags>
    <PackageLicenseUrl></PackageLicenseUrl>
    <LangVersion>latest</LangVersion>
    <!-- Package icon is centralized in ../../Directory.Build.props (PackageIcon). -->
    <PackageId>NumSharp</PackageId>
    <Product>NumSharp</Product>
    <Company>SciSharp STACK</Company>
    <RootNamespace>NumSharp</RootNamespace>
    <Version>0.60.0</Version>
    <Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Strong-naming (key, DelaySign, SignAssembly) is set repo-wide in ../../Directory.Build.props. -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <Platforms>AnyCPU</Platforms>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Configurations>Debug;Release;Publish</Configurations>
    <AssemblyName>NumSharp</AssemblyName>
    <PackageVersion>0.60.0</PackageVersion>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- GenerateDocumentationFile turns on the whole XML-doc-comment validation family. NumSharp
         mirrors NumPy's API surface rather than curating per-member XML docs, so these are pure
         noise here; we still EMIT the .xml doc file (for IntelliSense), we just don't validate it.
         Every code below is exclusively an XML-documentation diagnostic — none overlaps a
         code-correctness warning:
           CS0419 ambiguous cref            CS1570 badly-formed XML          CS1571 dup param tag
           CS1572 param tag, no param       CS1573 param, no param tag       CS1574 unresolved cref
           CS1580 bad cref param type       CS1581 bad cref return type      CS1584 malformed cref
           CS1587 comment not on element    CS1589/1590/1592/1598 <include>  CS1591 missing comment
           CS1658 keyword in cref           CS1710/1712 typeparam tag        CS1711 typeparam, none
           CS1723 cref to type param        CS1734 paramref, no param -->
    <NoWarn>$(NoWarn);CS0419;CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1598;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734</NoWarn>
    <!-- Two non-doc warnings on INTENTIONAL design choices, not fixable noise:
           CS8981 the lowercase API type names (np, linalg, fft, …) that mirror NumPy's surface —
                  the "may become reserved for the language" note is future-proofing we accept.
           CS8500 address-of / pointer-to a managed type T in the unmanaged-storage unsafe kernels —
                  inherent to NumSharp's raw-pointer memory model. -->
    <NoWarn>$(NoWarn);CS8981;CS8500</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Publish|AnyCPU'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="NumSharp.Core.csproj.DotSettings" />
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Ships into the NumSharp package so a downstream consumer imports the NDW013 guard: a build
         warning when [NDScoped]/[NDScopedAsync] is used but the NumSharp.Build package is not
         installed (the attributes are then inert and the temporaries leak). See build/NumSharp.targets. -->
    <None Include="build/NumSharp.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <!-- ==================================================================================
       Compile-time leak analyzer (NDW012) for NumSharp.Core's OWN build — AND the analyzer
       the NumSharp PACKAGE ships to its consumers.

       The NumSharp.Build.Analyzer flags an NDArray a method creates but never returns, out/ref's,
       stores, disposes, or yields to an NDScope — a transient left to the finalizer. Referencing it
       with OutputItemType="Analyzer" (ReferenceOutputAssembly=false, so netstandard2.0 is never a
       runtime ref) runs it during Core's compile, so `dotnet build` on NumSharp captures leaks in
       np.* code, not just in downstream consumers.

       The analyzer ALSO carries the [NDScoped]-target gate (NDW002/003/005/006/009/010/011), but on
       Core those are REDUNDANT with the self-weave (which validates every [NDScoped] method
       post-compile) and have never run over Core's full attributed surface — so they are turned off
       for Core's own build in src/NumSharp.Core/.editorconfig, leaving only the NDW012 leak warning.

       SHIPPING: the analyzer DLL is ALSO packed into THIS package's analyzers/dotnet/cs/ (see
       _NumSharpCorePackAnalyzer below), so every PackageReference consumer of NumSharp gets the
       NDW diagnostics — the [NDScoped]-target gate as compile ERRORS and the NDW012 leak nudge —
       WITHOUT installing anything else. The NumSharp.Build package is weaver-ONLY (tool + targets,
       no analyzers/): its job is the post-compile weave, and shipping the analyzer here instead of
       there means the two packages installed together never double-apply it. The attributes and the
       analyzer both living in/with NumSharp keeps them version-locked to the surface they validate.

       Toggle: -p:EnableNDArrayLeakAnalyzer=false removes the analyzer from Core's COMPILE — the
       P2P below stays (without OutputItemType) so the DLL is still BUILT and the package still
       ships it; the toggle governs analysis of Core, never the package payload.
       ================================================================================== -->
  <PropertyGroup>
    <EnableNDArrayLeakAnalyzer Condition="'$(EnableNDArrayLeakAnalyzer)' == ''">true</EnableNDArrayLeakAnalyzer>
    <!-- NDW012 is a non-breaking NUDGE, never a build-breaker. Keep it a WARNING even if this build
         ever turns on TreatWarningsAsErrors, so a detected leak (Core has hundreds, mostly ambient-
         scope-covered helpers) can never fail Core's own build. -->
    <WarningsNotAsErrors Condition="'$(EnableNDArrayLeakAnalyzer)' == 'true'">$(WarningsNotAsErrors);NDW012</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableNDArrayLeakAnalyzer)' == 'true'">
    <ProjectReference Include="..\..\tools\NumSharp.Build.Analyzer\NumSharp.Build.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <!-- Toggle OFF still builds the analyzer (no OutputItemType → it never analyzes Core): the pack
       target below stages its DLL by GetTargetPath WITHOUT a rebuild, so the DLL must exist from
       the ordinary build whatever the toggle says. PrivateAssets=all + IsPackable=false on the
       analyzer keep this out of the nuspec dependency list in both branches. -->
  <ItemGroup Condition="'$(EnableNDArrayLeakAnalyzer)' != 'true'">
    <ProjectReference Include="..\..\tools\NumSharp.Build.Analyzer\NumSharp.Build.Analyzer.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- ==================================================================================
       Pack the analyzer into the NumSharp package (analyzers/dotnet/cs/).

       NuGet auto-applies analyzers/dotnet/cs/ to a consumer's C# compile, so referencing
       NumSharp alone turns on the NDW diagnostics. Same mechanics as the weaver package's
       old staging (which moved here): GetTargetPath resolves the DLL WITHOUT a rebuild —
       safe under a no-build pack (the way CI packs: build with Rebuild, then pack with no
       rebuild; the P2P above built the DLL) — and RemoveProperties="TargetFramework" strips
       the inner build's net8.0/net10.0 global so the analyzer resolves its own
       netstandard2.0 output.

       TfmSpecificContentInPackage runs once PER TFM in TargetFrameworks; analyzers/ is a
       TFM-agnostic folder, so the target stages on the net8.0 pass only (the repo's floor
       TFM) — both passes adding the same file would draw NU5118.
       ================================================================================== -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_NumSharpCorePackAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_NumSharpCorePackAnalyzer" Condition="'$(TargetFramework)' == 'net8.0'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\tools\NumSharp.Build.Analyzer\NumSharp.Build.Analyzer.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_NumSharpCoreAnalyzer" />
    </MSBuild>
    <!-- Loud, actionable failure instead of a silently analyzer-less nupkg (the gates —
         verify_strong_name.cs and verify_build_package.sh step 2 — assert presence too). -->
    <Error Condition="'@(_NumSharpCoreAnalyzer)' == '' or !Exists('@(_NumSharpCoreAnalyzer)')"
           Text="NumSharp pack: NumSharp.Build.Analyzer.dll not found (looked at '@(_NumSharpCoreAnalyzer)'). Build the solution (or NumSharp.Core, whose ProjectReference builds the analyzer) before packing with --no-build." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_NumSharpCoreAnalyzer)" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

  <Target Name="LogDebugInfo">
    <Message Text="Building for $(TargetFramework) on $(OS)" Importance="High" />
  </Target>

  <!-- ==================================================================================
       NDScope IL weaving (see DISPOSAL-GUIDELINES.md → "The weaver — [NDScoped]").

       After each inner (per-TargetFramework) compile, tools/NumSharp.Build rewrites the
       intermediate assembly: every [NDScoped] method gets the ambient-reclamation-scope
       pattern injected (scope = NDScope.Open() prologue, body wrapped in try/finally with
       scope.Dispose(), every ret routed through scope.Returns, out-NDArray params yielded)
       so the SOURCE keeps its 100% original body. The weaver re-signs with the repo key
       (IL rewriting invalidates the compile-time strong-name signature — StrongNameTests
       gates this) and rewrites the portable PDB in place.

       Incremental: Inputs/Outputs on a per-TFM marker file — when CoreCompile was skipped
       the weave is skipped too; when it reran, the fresh (unwoven) dll is newer than the
       marker and the weave reruns. The weaver itself is additionally idempotent (a method
       whose body already opens an NDScope is skipped), so double-weaving is impossible
       even if the marker is deleted by hand.

       The weaver project is restored+built on demand via two separate MSBuild task calls
       with DIFFERENT global-property sets — a Restore and Build sharing one property set
       would reuse the pre-restore project evaluation and fail the first clean build.

       Escape hatches: -p:SkipNDScopeWeave=true skips entirely (the hand-written scope
       sites keep working — weaving only ADDS scopes to attributed methods);
       -p:NDScopeWeaveILVerify=true additionally runs the dotnet-ilverify global tool on
       the woven assembly (kept opt-in so machines without the tool still build).
       ================================================================================== -->
  <PropertyGroup>
    <NumSharpBuildProject>$(MSBuildThisFileDirectory)..\..\tools\NumSharp.Build\NumSharp.Build.csproj</NumSharpBuildProject>
    <!-- Host selection, same ladder as the packaged build/NumSharp.Build.targets: prefer
         DOTNET_HOST_PATH (set by the dotnet CLI / .NET-Core MSBuild for exactly this
         hand-off) over a bare PATH 'dotnet', so a VS devenv build of the solution does not
         depend on PATH hygiene. -->
    <NumSharpBuildDotnetHost Condition="'$(NumSharpBuildDotnetHost)' == '' and '$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</NumSharpBuildDotnetHost>
    <NumSharpBuildDotnetHost Condition="'$(NumSharpBuildDotnetHost)' == ''">dotnet</NumSharpBuildDotnetHost>
  </PropertyGroup>

  <!-- The marker path is spelled inline (not via a body-level property): IntermediateOutputPath
       is assigned by the SDK's .targets, which import AFTER the project body — a body-level
       property would capture it EMPTY. Target Inputs/Outputs expand at target-execution time,
       where the per-TFM obj path is final. -->
  <!-- BeforeTargets mirrors the packaged build/NumSharp.Build.targets anchor set:
       _TimeStampAfterCompile keeps the SDK's post-compile timestamping consistent with the
       rewritten assembly, AfterCompile lets AfterCompile-hooked rewriters see the woven IL;
       MSBuild ignores anchors naming targets a project never defines. -->
  <Target Name="NDScopeWeave"
          AfterTargets="CoreCompile"
          BeforeTargets="_TimeStampAfterCompile;AfterCompile;CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipNDScopeWeave)' != 'true'"
          Inputs="@(IntermediateAssembly)"
          Outputs="$(IntermediateOutputPath)NDScopeWeave.marker">

    <!-- RemoveProperties: the parent inner build's TargetFramework/RID globals must not leak
         into the single-TFM weaver project (they mis-key its restore/build). -->
    <MSBuild Projects="$(NumSharpBuildProject)" Targets="Restore" Properties="Configuration=Release"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;Platform;Platforms" />
    <MSBuild Projects="$(NumSharpBuildProject)" Targets="Build" Properties="Configuration=Release;NDScopeWeaverInner=true"
             RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;Platform;Platforms">
      <Output TaskParameter="TargetOutputs" ItemName="NumSharpBuildAssembly" />
    </MSBuild>

    <Exec Command="&quot;$(NumSharpBuildDotnetHost)&quot; exec &quot;@(NumSharpBuildAssembly)&quot; &quot;@(IntermediateAssembly)&quot; --snk &quot;$(AssemblyOriginatorKeyFile)&quot;" />

    <!-- Opt-in IL verification of the woven output (dotnet tool install -g dotnet-ilverify). -->
    <ItemGroup Condition="'$(NDScopeWeaveILVerify)' == 'true'">
      <_NDScopeILVerifyRefDir Include="@(ReferencePathWithRefAssemblies->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <Exec Condition="'$(NDScopeWeaveILVerify)' == 'true'"
          Command="ilverify &quot;@(IntermediateAssembly)&quot; @(_NDScopeILVerifyRefDir->'-r &quot;%(Identity)*.dll&quot;', ' ')" />

    <Touch Files="$(IntermediateOutputPath)NDScopeWeave.marker" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)NDScopeWeave.marker" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

</Project>
