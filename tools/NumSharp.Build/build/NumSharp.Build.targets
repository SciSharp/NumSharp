<Project>
  <!-- ==================================================================================
       NumSharp.Build — the consumer-side NDScopeWeave target.

       Imported into any project that references the NumSharp.Build package (NuGet places
       build/<id>.targets at the end of the project's import chain, per TargetFramework).
       After each per-TFM compile it rewrites the INTERMEDIATE assembly: every [NDScoped]
       method gets the ambient-reclamation-scope pattern injected (scope = NDScope.Open()
       prologue, body wrapped in try/finally with scope.Dispose(), every ret routed through
       scope.Returns, out-NDArray params yielded) so the SOURCE keeps its 100% original
       body. NDScope and the attribute live in the REFERENCED NumSharp assembly, so the
       compiler's own reference list is handed to the tool (the refs response file written
       below, one path per line) for cross-assembly resolution. A project with no [NDScoped] methods is left byte-for-byte
       untouched.

       Incremental: Inputs/Outputs on a per-TFM marker file — when CoreCompile was skipped
       the weave is skipped too; when it reran, the fresh (unwoven) dll is newer than the
       marker and the weave reruns. The weaver itself is additionally idempotent (a method
       whose body already opens an NDScope is skipped), so double-weaving is impossible
       even if the marker is deleted by hand.

       Strong naming: IL rewriting invalidates a compile-time signature, so a genuinely
       full-signed project is re-signed with its own key ($(KeyOriginatorFile)); unsigned,
       delay-signed and public-signed projects are written as-is (they carry no valid
       signature to restore).

       THIS FILE IS THE ONLY DEFINITION OF THE WEAVE STEP. NumSharp.Core's own self-weave
       imports it too (src/NumSharp.Core/NumSharp.Core.csproj — which adds just a
       build-the-tool-from-source step ahead of it and points $(NumSharpBuildToolDll) at the
       result), as does the source-mode example examples/NDScoping. There is deliberately no
       second copy anywhere: a hardening added here reaches the package consumer, the
       self-weave and the example at once, and the three cannot drift apart. Keep every
       Core-specific need expressible through the knobs below rather than by forking the
       target.

       Escape hatches (shared by every consumer and by NumSharp.Core's self-weave):
         -p:SkipNDScopeWeave=true      build without weaving — [NDScoped] methods run
                                       unscoped (the finalizer backstop); nothing else
                                       changes, the attribute is inert (and the NDW013
                                       guard says so, since $(NumSharpBuildActive) is then
                                       not set).
         -p:NDScopeWeaveILVerify=true  additionally run the dotnet-ilverify global tool
                                       on the woven assembly (opt-in so machines without
                                       the tool still build).
         $(NumSharpBuildToolDll)      override the tool path (e.g. a locally built
                                       weaver) — set it in the project file body, or (as
                                       NumSharp.Core does) from a target that runs before
                                       NDScopeWeave: the path is expanded at execution.
       ================================================================================== -->
  <!-- Forward slashes + NormalizePath: the path reaches Exec's SHELL (cmd on Windows, sh on
       Linux/macOS), and a raw backslash path breaks the Unix side — same convention as the
       NumSharp.Interop.OpenBLAS buildTransitive files. -->
  <!-- Signals to NumSharp.Core's build/NumSharp.targets that a weaver IS installed and will run,
       so its "you marked [NDScoped] but nothing weaves it" warning (NDW013) stays silent. Set only
       when weaving is actually enabled: under -p:SkipNDScopeWeave=true the attributes ARE inert, so
       the NDW013 nudge SHOULD fire, exactly as it does with no weaver package at all. A top-level
       property (not inside a target) so it is evaluated before NumSharp.Core's post-compile check. -->
  <PropertyGroup Condition="'$(SkipNDScopeWeave)' != 'true'">
    <NumSharpBuildActive>true</NumSharpBuildActive>
  </PropertyGroup>

  <!-- The compile-time analyzer (shipped in the NumSharp package) reads the same two knobs
       (build_property.* in the generated editorconfig) as the PRIMARY NDW013 reporter: when they
       say the weaver is inactive it warns at every member it would have woven — an own
       [NDScoped]/[NDScopedAsync]/[NDScopedExit] and an inherited one alike, the latter the shape no
       metadata text scan can see. NumSharp's build/NumSharp.targets declares them (defaulting
       NumSharpBuildActive to false) for package consumers; this copy serves the source-mode consumer
       that imports only this file, so the property is DECLARED there too (true here = silent). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="NumSharpBuildActive" />
    <CompilerVisibleProperty Include="NumSharpDisableWeaverMissingWarning" />
  </ItemGroup>

  <PropertyGroup>
    <NumSharpBuildToolDll Condition="'$(NumSharpBuildToolDll)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../tools/net8.0/any/NumSharp.Build.dll'))</NumSharpBuildToolDll>

    <!-- Host selection — no bare PATH assumption where a better answer exists (the
         Nucs.JsonSettings.Autosave lesson: a build step that shells 'dotnet' dies on hosts
         that never put it on PATH). DOTNET_HOST_PATH is set by the dotnet CLI / .NET-Core
         MSBuild for exactly this hand-off and is the SDK-documented way for a build step to
         find its own host. Full-framework MSBuild (VS devenv) does not set it; there the
         PATH fallback holds because the .NET SDK installer registers dotnet machine-wide.
         Overridable, like the tool path. -->
    <NumSharpBuildDotnetHost Condition="'$(NumSharpBuildDotnetHost)' == '' and '$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</NumSharpBuildDotnetHost>
    <NumSharpBuildDotnetHost Condition="'$(NumSharpBuildDotnetHost)' == ''">dotnet</NumSharpBuildDotnetHost>
  </PropertyGroup>

  <!-- ==================================================================================
       Compile-time analyzer — the SOURCE-mode half of the story.

       This package ships NO analyzer of its own: the compile-time analyzer rides the NumSharp
       package itself (analyzers/dotnet/cs/ there — NuGet AUTO-APPLIES it; note that the .NET SDK
       still applies a package's analyzers even under `ExcludeAssets="analyzers"`, observed on
       10.0.101, so a PackageReference consumer cannot shed it that way), so a PackageReference
       consumer already has the diagnostics and nothing here is needed. A SOURCE-mode consumer — one that
       IMPORTS these targets directly AND references NumSharp.Core by ProjectReference (the
       in-repo recipe, where no package delivers the analyzer) — opts in by pointing
       $(NumSharpBuildAnalyzerDll) at the built analyzer DLL, EXACTLY as it already points
       $(NumSharpBuildToolDll) at the built tool. That makes the same
       NDW002/003/005/006/009/010/011 diagnostics fail the build at CoreCompile (and squiggle in
       the IDE) for a csproj consumer too, not just the weaver's post-compile pass.

       Deliberately NO DEFAULT: an unset property adds nothing, so a real PackageReference build
       never double-applies the analyzer (the Include below also skips when NumSharp.Build.Analyzer
       is already among @(Analyzer)). A top-level ItemGroup (not a target) so the analyzer is
       present for the IDE's design-time analysis as well as the command-line build. -->
  <ItemGroup Condition="'$(NumSharpBuildAnalyzerDll)' != '' and Exists('$(NumSharpBuildAnalyzerDll)')">
    <Analyzer Include="$(NumSharpBuildAnalyzerDll)"
              Condition="'@(Analyzer->WithMetadataValue('Filename','NumSharp.Build.Analyzer'))' == ''" />
  </ItemGroup>

  <!-- BeforeTargets carries the battle-tested anchor set alongside the copy: running before
       _TimeStampAfterCompile keeps the SDK's own post-compile timestamping consistent with
       the rewritten assembly, and running before AfterCompile means AfterCompile-hooked IL
       rewriters (MAUI's XamlC and friends) see the WOVEN assembly rather than racing it.
       MSBuild ignores Before/AfterTargets naming targets a project never defines, so the
       extra anchors are inert where those targets do not exist. Foreign rewriters that bump
       the assembly's timestamp WITHOUT recompiling only re-trigger this target into a cheap
       no-op: the weave is per-method idempotent (a body already opening an NDScope is
       skipped) and a nothing-woven pass does not rewrite the file at all. -->
  <Target Name="NDScopeWeave"
          AfterTargets="CoreCompile"
          BeforeTargets="_TimeStampAfterCompile;AfterCompile;CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipNDScopeWeave)' != 'true' and '@(IntermediateAssembly)' != ''"
          Inputs="@(IntermediateAssembly)"
          Outputs="$(IntermediateOutputPath)NDScopeWeave.marker">

    <Error Condition="!Exists('$(NumSharpBuildToolDll)')"
           Code="NDW000"
           Text="NumSharp.Build: tool not found at '$(NumSharpBuildToolDll)' — the NumSharp.Build package is incomplete or a NumSharpBuildToolDll override points nowhere. Restore the package, or build with -p:SkipNDScopeWeave=true to skip weaving." />

    <!-- Content pre-scan: spawn the tool only when the assembly can possibly need it. Using
         any of the attributes compiles a TypeRef whose name lands as an ASCII run in the metadata
         #Strings heap, and ASCII runs survive lossy UTF-8 decoding of arbitrary binary
         intact — so a plain text scan is a reliable "was a weavable attribute used?" probe on a
         fresh compiler output (the Nucs.JsonSettings.Autosave marker-scan technique). The probe
         matches the three WEAVABLE type names exactly — 'NDScopedAttribute', 'NDScopedAsyncAttribute'
         and 'NDScopedExitAttribute' (the regex NDScoped(Async|Exit)?Attribute) — rather than the
         bare shared prefix 'NDScoped'. All three must be covered (neither the async nor the exit
         name contains 'NDScopedAttribute' as a substring, so probing the sync name alone would skip
         an async-only or exit-only consumer), and matching the full names — not the prefix — keeps
         [NDScopedCovered] (the analyzer-only hint attribute, inert at runtime and needing NO weaver)
         from spawning the tool: 'NDScopedCoveredAttribute' matches none of them. A false POSITIVE
         (a matched name in a user string literal) merely spawns the tool, which no-ops; there is no
         false negative on CoreCompile output.

         INHERITED targets are invisible to the text probe: an override/implementation of a
         scoped virtual, abstract or interface member declared in ANOTHER assembly (a NumSharp
         class, or any referenced library that used the weaver) carries no attribute of its own —
         its metadata names the base type, never the attribute — yet the weaver must weave it
         (ScopeInheritance). Such an override can only exist in an assembly that references
         NumSharp, so a compile whose reference list carries NumSharp spawns the tool as well; the
         tool itself is the precise probe (it walks every virtual method's override graph and
         exits without rewriting when nothing is a target). The text scan still keeps consumers
         that do NOT reference NumSharp at all — a solution-wide package install reaching an
         unrelated project — free of the per-build process spawn. -->
    <PropertyGroup>
      <_NDScopeWeaveAssembly>@(IntermediateAssembly->'%(FullPath)')</_NDScopeWeaveAssembly>
      <_NDScopeWeaveHasUsage>false</_NDScopeWeaveHasUsage>
      <!-- ONE read of the assembly, every weavable name in a single regex (the decoded text is never
           stored in a property — a multi-megabyte value would be echoed into diagnostic logs/binlogs). -->
      <_NDScopeWeaveHasUsage Condition="Exists('$(_NDScopeWeaveAssembly)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_NDScopeWeaveAssembly)')), 'NDScoped(Async|Exit)?Attribute'))">true</_NDScopeWeaveHasUsage>
      <_NDScopeWeaveHasUsage Condition="'$(_NDScopeWeaveHasUsage)' != 'true' and '@(ReferencePathWithRefAssemblies->WithMetadataValue('Filename','NumSharp'))' != ''">true</_NDScopeWeaveHasUsage>
    </PropertyGroup>
    <Message Condition="'$(_NDScopeWeaveHasUsage)' != 'true'"
             Importance="normal"
             Text="NumSharp.Build: no [NDScoped]/[NDScopedAsync]/[NDScopedExit] usage detected in $(MSBuildProjectName) and NumSharp is not referenced; weave skipped" />

    <!-- The compile's reference list, one path per line: how the tool resolves NDScope /
         NDArray / INDArrayCarrier out of the referenced NumSharp assembly (reference
         assemblies are fine — the weaver imports member signatures, never bodies). A
         response file, so a large dependency graph cannot overflow the command line. -->
    <WriteLinesToFile Condition="'$(_NDScopeWeaveHasUsage)' == 'true'"
                      File="$(IntermediateOutputPath)NDScopeWeave.refs.rsp"
                      Lines="@(ReferencePathWithRefAssemblies)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- Re-sign only a genuinely full-signed assembly. KeyOriginatorFile is the project's
         resolved key; Exec runs in the project directory, so a relative path resolves. -->
    <PropertyGroup>
      <_NDScopeWeaveSnkArg></_NDScopeWeaveSnkArg>
      <_NDScopeWeaveSnkArg Condition="'$(SignAssembly)' == 'true' and '$(DelaySign)' != 'true' and '$(PublicSign)' != 'true' and '$(KeyOriginatorFile)' != '' and Exists('$(KeyOriginatorFile)')">--snk "$(KeyOriginatorFile)"</_NDScopeWeaveSnkArg>
    </PropertyGroup>

    <Exec Condition="'$(_NDScopeWeaveHasUsage)' == 'true'"
          Command="&quot;$(NumSharpBuildDotnetHost)&quot; exec &quot;$(NumSharpBuildToolDll)&quot; &quot;@(IntermediateAssembly)&quot; --refs &quot;$(IntermediateOutputPath)NDScopeWeave.refs.rsp&quot; $(_NDScopeWeaveSnkArg)" />

    <!-- Opt-in IL verification of the woven output (dotnet tool install -g dotnet-ilverify). -->
    <ItemGroup Condition="'$(NDScopeWeaveILVerify)' == 'true'">
      <_NDScopeILVerifyRefDir Include="@(ReferencePathWithRefAssemblies->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <Exec Condition="'$(NDScopeWeaveILVerify)' == 'true'"
          Command="ilverify &quot;@(IntermediateAssembly)&quot; @(_NDScopeILVerifyRefDir->'-r &quot;%(Identity)*.dll&quot;', ' ')" />

    <Touch Files="$(IntermediateOutputPath)NDScopeWeave.marker" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)NDScopeWeave.marker" />
      <FileWrites Include="$(IntermediateOutputPath)NDScopeWeave.refs.rsp" />
    </ItemGroup>
  </Target>

  <!-- ==================================================================================
       NOT CONTAGIOUS — the pack-time guard (NDW018).

       NumSharp.Build weaves the project it is installed in and nothing downstream. A library that
       installs it must NOT hand it on: a consumer of that library's package gets no weaver (its own
       [NDScoped] methods stay inert, exactly as if the package did not exist), and it should not even
       see NumSharp.Build in its dependency graph. Three layers make that so, and this target is the
       third:

         1. This package ships no lib/ and no dependency entries, and build/ only (never
            buildTransitive/), so NuGet applies its targets ONLY to a project that references it
            directly — a project that merely references a woven library, by ProjectReference or by
            package, never imports them and is never woven. (Measured: a consumer of a library whose
            nuspec DID list NumSharp.Build still was not woven — NuGet records the default
            PrivateAssets of `build` as exclude="Build,Analyzers" on the edge — so weaving cannot leak
            even in the worst case below.)
         2. developmentDependency=true makes `dotnet add package NumSharp.Build` (and the VS UI) write
            PrivateAssets="all" on the reference, which keeps the package out of the referencing
            project's own nuspec. That is the install path the docs teach.
         3. A HAND-WRITTEN reference (a csproj edited by hand, or Central Package Management, where the
            author writes <PackageReference Include="NumSharp.Build" /> and no PrivateAssets) has no
            such help: `dotnet pack` would list NumSharp.Build as a DEPENDENCY of the author's package
            and every consumer would restore the weaver's payload. This target refuses that pack.

       The check reads the project's assets file (project.assets.json) rather than the PackageReference
       item, because that file is what the pack task itself reads for the dependency list: the
       project-section record for NumSharp.Build carries "suppressParent": "All" exactly when the
       reference had PrivateAssets="all" at RESTORE time — so a stale restore, a pack that skipped
       restore, or a PrivateAssets typed after the last restore is judged by what will actually be
       packed. (An XML comment cannot spell the skip-restore switch itself: two dashes end it.) A
       package cannot fix this for its consumers silently: NuGet restores with
       ExcludeRestorePackageImports=true, so a props file shipped here (a PackageReference Update
       setting PrivateAssets) never reaches the restore graph and the pack would still leak — measured,
       twice, before this guard was written; erroring with the one-line fix is the honest option.

       Scope: only a PACKABLE project being packed (GenerateNuspec) — an application that references
       the weaver has nothing to leak and is never bothered. Opt-out for the deliberate case:
       -p:NumSharpBuildAllowAsDependency=true (or the property in the project) packs it as a
       dependency anyway; its consumers are still not woven (layer 1).
       ================================================================================== -->
  <Target Name="_NumSharpBuildRefuseContagiousPack"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(NumSharpBuildAllowAsDependency)' != 'true'">
    <PropertyGroup>
      <_NumSharpBuildAssetsFile>$(ProjectAssetsFile)</_NumSharpBuildAssetsFile>
      <_NumSharpBuildLeaks>false</_NumSharpBuildLeaks>
      <!-- A project-section dependency record — the key is the bare id ("NumSharp.Build", never the
           "NumSharp.Build/1.2.3" form the targets/libraries sections use, and never the plain-string
           value of a Central Package Management centralPackageVersions entry) — whose body lacks
           "suppressParent": "All". One record per TargetFramework; any one without it leaks. -->
      <_NumSharpBuildLeaks Condition="Exists('$(_NumSharpBuildAssetsFile)') and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_NumSharpBuildAssetsFile)')), '&quot;NumSharp\.Build&quot;\s*:\s*\{(?![^}]*&quot;suppressParent&quot;\s*:\s*&quot;All&quot;)[^}]*\}'))">true</_NumSharpBuildLeaks>
    </PropertyGroup>
    <Error Condition="'$(_NumSharpBuildLeaks)' == 'true'"
           Code="NDW018"
           Text="$(MSBuildProjectName) references NumSharp.Build without PrivateAssets=&quot;all&quot;, so packing would list NumSharp.Build as a DEPENDENCY of $(PackageId) and every consumer of your package would restore the weaver. NumSharp.Build is a build-time tool for the project it is installed in and is not meant to be inherited (consumers are never woven either way). Add PrivateAssets=&quot;all&quot; to the PackageReference — `dotnet add package NumSharp.Build` writes it for you — then restore and pack again; or set NumSharpBuildAllowAsDependency=true to pack it as a dependency on purpose. See https://scisharp.github.io/NumSharp/docs/numsharp-build-compiler.html#ndw018" />
  </Target>
</Project>
