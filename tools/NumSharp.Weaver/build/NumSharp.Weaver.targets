<Project>
  <!-- ==================================================================================
       NumSharp.Weaver — the consumer-side NDScopeWeave target.

       Imported into any project that references the NumSharp.Weaver package (NuGet places
       build/<id>.targets at the end of the project's import chain, per TargetFramework).
       After each per-TFM compile it rewrites the INTERMEDIATE assembly: every [NDScoped]
       method gets the ambient-reclamation-scope pattern injected (scope = NDScope.Open()
       prologue, body wrapped in try/finally with scope.Dispose(), every ret routed through
       scope.Returns, out-NDArray params yielded) so the SOURCE keeps its 100% original
       body. NDScope and the attribute live in the REFERENCED NumSharp assembly, so the
       compiler's own reference list is handed to the tool (the refs response file written
       below, one path per line) for cross-assembly resolution. A project with no [NDScoped] methods is left byte-for-byte
       untouched.

       Incremental: Inputs/Outputs on a per-TFM marker file — when CoreCompile was skipped
       the weave is skipped too; when it reran, the fresh (unwoven) dll is newer than the
       marker and the weave reruns. The weaver itself is additionally idempotent (a method
       whose body already opens an NDScope is skipped), so double-weaving is impossible
       even if the marker is deleted by hand.

       Strong naming: IL rewriting invalidates a compile-time signature, so a genuinely
       full-signed project is re-signed with its own key ($(KeyOriginatorFile)); unsigned,
       delay-signed and public-signed projects are written as-is (they carry no valid
       signature to restore).

       Escape hatches (same as NumSharp.Core's own self-weave):
         -p:SkipNDScopeWeave=true      build without weaving — [NDScoped] methods run
                                       unscoped (the finalizer backstop); nothing else
                                       changes, the attribute is inert.
         -p:NDScopeWeaveILVerify=true  additionally run the dotnet-ilverify global tool
                                       on the woven assembly (opt-in so machines without
                                       the tool still build).
         $(NumSharpWeaverToolDll)      override the tool path (e.g. a locally built
                                       weaver) — set it in the project file body.
       ================================================================================== -->
  <PropertyGroup>
    <NumSharpWeaverToolDll Condition="'$(NumSharpWeaverToolDll)' == ''">$(MSBuildThisFileDirectory)..\tools\net8.0\any\NumSharp.Weaver.dll</NumSharpWeaverToolDll>
  </PropertyGroup>

  <Target Name="NDScopeWeave"
          AfterTargets="CoreCompile"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipNDScopeWeave)' != 'true' and '@(IntermediateAssembly)' != ''"
          Inputs="@(IntermediateAssembly)"
          Outputs="$(IntermediateOutputPath)NDScopeWeave.marker">

    <Error Condition="!Exists('$(NumSharpWeaverToolDll)')"
           Text="NumSharp.Weaver: tool not found at '$(NumSharpWeaverToolDll)' — the NumSharp.Weaver package is incomplete or a NumSharpWeaverToolDll override points nowhere. Restore the package, or build with -p:SkipNDScopeWeave=true to skip weaving." />

    <!-- The compile's reference list, one path per line: how the tool resolves NDScope /
         NDArray / INDArrayCarrier out of the referenced NumSharp assembly (reference
         assemblies are fine — the weaver imports member signatures, never bodies). A
         response file, so a large dependency graph cannot overflow the command line. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)NDScopeWeave.refs.rsp"
                      Lines="@(ReferencePathWithRefAssemblies)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- Re-sign only a genuinely full-signed assembly. KeyOriginatorFile is the project's
         resolved key; Exec runs in the project directory, so a relative path resolves. -->
    <PropertyGroup>
      <_NDScopeWeaveSnkArg></_NDScopeWeaveSnkArg>
      <_NDScopeWeaveSnkArg Condition="'$(SignAssembly)' == 'true' and '$(DelaySign)' != 'true' and '$(PublicSign)' != 'true' and '$(KeyOriginatorFile)' != '' and Exists('$(KeyOriginatorFile)')">--snk "$(KeyOriginatorFile)"</_NDScopeWeaveSnkArg>
    </PropertyGroup>

    <Exec Command="dotnet exec &quot;$(NumSharpWeaverToolDll)&quot; &quot;@(IntermediateAssembly)&quot; --refs &quot;$(IntermediateOutputPath)NDScopeWeave.refs.rsp&quot; $(_NDScopeWeaveSnkArg)" />

    <!-- Opt-in IL verification of the woven output (dotnet tool install -g dotnet-ilverify). -->
    <ItemGroup Condition="'$(NDScopeWeaveILVerify)' == 'true'">
      <_NDScopeILVerifyRefDir Include="@(ReferencePathWithRefAssemblies->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <Exec Condition="'$(NDScopeWeaveILVerify)' == 'true'"
          Command="ilverify &quot;@(IntermediateAssembly)&quot; @(_NDScopeILVerifyRefDir->'-r &quot;%(Identity)*.dll&quot;', ' ')" />

    <Touch Files="$(IntermediateOutputPath)NDScopeWeave.marker" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)NDScopeWeave.marker" />
      <FileWrites Include="$(IntermediateOutputPath)NDScopeWeave.refs.rsp" />
    </ItemGroup>
  </Target>
</Project>
