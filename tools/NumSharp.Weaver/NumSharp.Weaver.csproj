<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NumSharp.Weaver</AssemblyName>
    <RootNamespace>NumSharp.Weaver</RootNamespace>
    <!-- A build TOOL: it never loads into a user's app, so its own assembly identity is
         irrelevant (and Mono.Cecil beside it carries Cecil's key, not NumSharp's). -->
    <SignAssembly>false</SignAssembly>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The tool must run on whatever runtime the consumer's machine has (an SDK-10-only box
         carries no .NET 8 runtime): bake roll-forward into runtimeconfig.json. -->
    <RollForward>Major</RollForward>
    <!-- `dotnet exec <dll>` is the invocation on every OS; a platform-specific apphost.exe
         would only bloat tools/ and bind the package to one RID. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- ==================================================================================
       Packaging — a BUILD-TIME WEAVER package, not a library dependency:

         tools/net8.0/any/    the weaver + Mono.Cecil (the PUBLISH output — the closed
                              set `dotnet exec` needs), expressed to NuGet as NOTHING:
                              no lib/, no dependency entries
         build/               NumSharp.Weaver.targets — wires the NDScopeWeave target
                              into the consuming project's build (after each per-TFM
                              CoreCompile, on the intermediate assembly)

       DevelopmentDependency=true makes `dotnet add package NumSharp.Weaver` write
       PrivateAssets="all" on the consumer's PackageReference, so installing it changes
       the consumer's BUILD, never the consumer's dependency graph — the weaver does not
       appear as a dependency of the consumer's own package. build/ (and deliberately
       NOT buildTransitive/) scopes the weave to exactly the project the package is
       installed on: a project that merely references a woven library is never woven.
       The [NDScoped] attribute itself ships in NumSharp.Core and is inert without this
       package, so adding/removing the package never changes results — only WHEN the
       transients' buffers are reclaimed. Gate: tools/verify_weaver_package.sh.
       ================================================================================== -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NumSharp.Weaver</PackageId>
    <Version>0.60.0</Version>
    <Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>
    <Authors>Eli Belash, Haiping Chen, Meinrad Recheis</Authors>
    <Company>SciSharp STACK</Company>
    <Product>NumSharp</Product>
    <Copyright>2021 © SciSharp STACK Team</Copyright>
    <Description>Build-time IL weaver for NumSharp's [NDScoped] deterministic memory reclamation. Installing this package wires a post-compile step into your project's build: every method you mark [NDScoped] is rewritten to open an NDScope, so the NDArray temporaries it drops are returned to NumSharp's buffer pool the moment the method exits instead of waiting on the finalizer. Ships as MSBuild targets + tools only — it never becomes a runtime dependency of your project (`dotnet add package` installs it with PrivateAssets="all" automatically).</Description>
    <PackageProjectUrl>https://scisharp.github.io/NumSharp/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SciSharp/NumSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>NumSharp, NDScope, NDScoped, weaver, IL, Mono.Cecil, MSBuild, memory, pooling, NumPy, SciSharp</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageOutputPath>../../packages</PackageOutputPath>

    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5100 (assemblies outside lib/ — that IS the design) / NU5128 (no lib per TFM). -->
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_NumSharpWeaverPackTool</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- NO PrivateAssets="all" here, deliberately: the SDK excludes PrivateAssets=all packages
         from the PUBLISH output, and publish is exactly what lands in tools/ — Cecil must ride
         along. Keeping Cecil out of the consumer's graph is SuppressDependenciesWhenPacking's
         job (the packed nuspec carries no dependency entries at all). -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The tool payload is the PUBLISH output (dll + runtimeconfig + deps + Mono.Cecil), not the
       bare build output — publish is the blessed closed set `dotnet exec` needs to resolve Cecil
       from beside the tool. Runs per packed TFM (there is one: net8.0). -->
  <Target Name="_NumSharpWeaverPackTool" DependsOnTargets="Publish">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(PublishDir)**/*" PackagePath="tools/net8.0/any/" />
    </ItemGroup>
  </Target>

</Project>
