<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <AssemblyName>NumSharp.Benchmark.CSharp</AssemblyName>
    <RootNamespace>NumSharp.Benchmark.CSharp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned (no floating version): the same BenchmarkDotNet across every benchmark project in
         the repo, so a measurement never silently changes with a NuGet feed refresh. -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NumSharp.Core\NumSharp.Core.csproj" />
  </ItemGroup>

</Project>
