[submodule "src/numpy"]
	path = refs/numpy
	url = https://github.com/numpy/numpy.git
[submodule "src/pocketfft"]
	path = refs/pocketfft
	url = https://github.com/mreineck/pocketfft.git
[submodule "src/OpenBLAS"]
	path = refs/OpenBLAS
	url = https://github.com/OpenMathLib/OpenBLAS.git
[submodule "refs/onnxruntime"]
	path = refs/onnxruntime
	url = https://github.com/microsoft/onnxruntime.git
[submodule "refs/onnxruntime-inference-examples"]
	path = refs/onnxruntime-inference-examples
	url = https://github.com/microsoft/onnxruntime-inference-examples.git
[submodule "refs/data"]
	path = refs/data
	url = https://github.com/SciSharp/NumSharp.git
	branch = data
	shallow = true
[submodule "refs/parquet-dotnet"]
	path = refs/parquet-dotnet
	url = https://github.com/aloneguid/parquet-dotnet.git
[submodule "refs/TensorSharp2"]
	path = refs/TensorSharp2
	url = https://github.com/SciSharp/TensorSharp2.git
